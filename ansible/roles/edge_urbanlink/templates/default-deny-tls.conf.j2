# {{ ansible_managed }}
# ============================================================================
#  Hote par defaut en TLS -- ce qui repond quand le `Host` ne correspond a rien
# ----------------------------------------------------------------------------
#  20-default-deny.conf couvrait deja le port 80. Le 443 n'avait AUCUN
#  `default_server` : nginx retombait alors sur le premier bloc `listen 443`
#  charge, c'est-a-dire folio.nbeny.fr, qui n'a pas de filtre d'acces. Tant que
#  l'origine n'etait joignable que du LAN, cela n'avait pas de portee. A partir
#  du moment ou elle repond a Internet, un scan de 82.65.87.60:443 -- sans SNI,
#  ou avec un Host arbitraire -- se voyait servir un site.
#
#  `return 444` ferme la connexion sans repondre : c'est ce que fait deja le
#  bloc du port 80, et cela ne renseigne pas le scanner.
#
#  Le certificat est celui d'urbanlink.fr. Son contenu importe peu -- nginx
#  exige juste un certificat valide pour terminer la poignee de main avant de
#  pouvoir couper -- mais il doit exister, sinon openresty refuse de demarrer.
#
# ----------------------------------------------------------------------------
#  ⚠️ NE JAMAIS RETIRER LE `include options-ssl-nginx.conf` CI-DESSOUS.
#
#  Le serveur par defaut d'une socket ne sert pas qu'aux `Host` inconnus : il
#  fournit le CONTEXTE SSL utilise pour la poignee de main de TOUTES les
#  connexions sur cette socket. `ssl_protocols` et `ssl_ciphers` y sont lus
#  AVANT que le SNI n'ait designe un vhost ; seul le certificat est ensuite
#  echange. Ce bloc gouverne donc la negociation TLS des quinze noms, pas
#  seulement la sienne.
#
#  Constate le 31/08/2026, en production : sans cet include, ce bloc heritait
#  du niveau `http` du nginx.conf d'OpenResty --
#
#      ssl_prefer_server_ciphers on;
#      ssl_protocols TLSv1.3;          <- TLS 1.3 SEUL
#
#  -- la ou tous les autres vhosts imposent `TLSv1.2 TLSv1.3` et
#  `prefer_server_ciphers off` via cet include. Tout le port 443 est passe en
#  TLS 1.3 strict, et l'origin pull de Cloudflare a cesse d'aboutir :
#  HelloRetryRequest (99 octets) puis alerte TLS (7 octets), soit une erreur
#  525 sur les six noms publics. Un `openssl s_client` local, lui, negociait
#  sans probleme -- le symptome ne se voyait QUE depuis Cloudflare.
# ============================================================================
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/{{ edge_urbanlink_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_urbanlink_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 444;
}
