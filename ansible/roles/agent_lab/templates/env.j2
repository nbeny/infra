# {{ ansible_managed }} -- roles/agent_lab. Secrets : NE PAS COPIER AILLEURS.
# Lu par systemd (EnvironmentFile) et par labctl/labtools.
AGENT_LAB_HOME={{ agent_lab_home }}
AGENT_LAB_DATA={{ agent_lab_data }}

# Abonnement Claude (`claude setup-token`), jamais une cle d'API.
CLAUDE_CODE_OAUTH_TOKEN={{ agent_lab_secret.CLAUDE_CODE_OAUTH_TOKEN }}

CLOUDFLARE_API_TOKEN={{ agent_lab_secret.CLOUDFLARE_API_TOKEN }}
CLOUDFLARE_ZONE_ID={{ agent_lab_secret.CLOUDFLARE_ZONE_ID }}

AGENT_LAB_PROMETHEUS_URL={{ agent_lab_gateway }}
AGENT_LAB_PROMETHEUS_HOST={{ agent_lab_prometheus_host }}
AGENT_LAB_GRAFANA_URL={{ agent_lab_gateway }}
AGENT_LAB_GRAFANA_HOST={{ agent_lab_grafana_host }}
GRAFANA_TOKEN={{ agent_lab_grafana_token }}

AGENT_LAB_SMTP_HOST={{ agent_lab_mail_name }}
AGENT_LAB_SMTP_PORT=587
AGENT_LAB_MAIL_FROM={{ agent_lab_mail_from }}
AGENTS_MAILBOX_PASSWORD={{ agent_lab_console.AGENTS_MAILBOX_PASSWORD }}

AGENT_LAB_EDGE_SSH=edge-log
AGENT_LAB_WOW_SSH=wow-ro
