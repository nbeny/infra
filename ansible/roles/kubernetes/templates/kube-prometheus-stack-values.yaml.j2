# {{ ansible_managed }}
# Valeurs Helm du kube-prometheus-stack -- role kubernetes (observability.yml).
#
# Deploie Prometheus (avec son operator), Grafana et Alertmanager dans le
# namespace `urbanconnect`, a cote de l'observabilite applicative posee par
# Argo (OTel/Tempo/Loki). Le Prometheus du MESH (addon Istio, istio-system)
# reste celui que consomme Kiali, expose sous prometheus.urbanlink.fr : c'est
# un SECOND Prometheus, volontairement separe, qui alimente les tableaux de
# bord Istio. Les deux cohabitent -- cf.
# config/prod/observability/grafana-datasources.yaml.
#
# Secrets : aucune valeur en clair n'est ecrite dans ce depot. Le compte admin
# de Grafana et les identifiants SMTP d'Alertmanager viennent de secrets.env,
# lus par observability.yml. Le jeton de scrape du backend n'est meme pas lu :
# le Secret `urbanconnect-secrets` est monte tel quel dans le pod Prometheus.

# --- Grafana ----------------------------------------------------------------
grafana:
  # LE MEME compte humain que les autres consoles internes (CONSOLE_ADMIN_USER
  # / CONSOLE_ADMIN_PASSWORD, cf. playbooks/34-console-accounts.yml). Grafana
  # n'a pas de compte de service a preserver a cote : sa configuration est
  # provisionnee par fichiers (les deux sidecars ci-dessous), jamais par son
  # API. Lui donner un mot de passe a lui seul aurait casse la promesse « un
  # seul couple pour toutes les consoles » sans rien proteger de plus.
  #
  # Grafana relit ces deux valeurs A CHAQUE DEMARRAGE : changer le mot de passe
  # dans secrets.env et rejouer ce role suffit a le faire suivre.
  adminUser: {{ console_admin_user }}
  adminPassword: "{{ console_admin_password }}"

  # Grafana construit des URL absolues (liens de partage, redirection apres
  # connexion, rendu d'images). Sans `root_url` il les batit sur
  # `localhost:3000` -- exactement le defaut corrige pour Kibana en aout. Le
  # TLS est termine par l'openresty du noeud, d'ou le `https` ici alors que le
  # pod, lui, ne parle qu'en clair.
  grafana.ini:
    server:
      domain: grafana.{{ k8s_observability_domain }}
      root_url: "https://grafana.{{ k8s_observability_domain }}"
    analytics:
      check_for_updates: false
      reporting_enabled: false

  # Lu par le provisionnement de la source « Postgres (metier) » (depot
  # applicatif, config/prod/observability/grafana-datasources.yaml) sous la
  # forme `$GRAFANA_PG_PASSWORD`. Grafana interpole les variables
  # d'environnement dans ses fichiers de provisionnement -- c'est ce qui permet
  # de declarer la source dans un depot SANS y ecrire le mot de passe.
  env:
    GRAFANA_PG_PASSWORD: "{{ grafana_pg_password }}"

  sidecar:
    datasources:
      enabled: true
      # Decouverte de la ConfigMap generee par kustomize : `grafana-datasources`
      # est etiquetee `grafana_datasource: "1"` (voir kustomization.yaml).
      label: grafana_datasource
      labelValue: "1"
      searchNamespace: {{ k8s_observability_namespace }}
      # ⚠️ Le chart pose SA PROPRE source « Prometheus », uid `prometheus` --
      # exactement le nom et l'uid que declare grafana-datasources.yaml. Grafana
      # refuse deux sources de meme nom : le provisionnement rend 500, et le
      # sidecar abandonne apres ses tentatives. Les QUATRE sources du depot
      # applicatif (Prometheus appli, Prometheus mesh, Tempo, Loki) restaient
      # alors absentes, sans aucun message dans l'UI -- seuls les tableaux de
      # bord, eux, apparaissaient. Mesure le 2026-09-01 :
      #   ERROR ... /api/admin/provisioning/datasources/reload: too many 500
      #
      # La source de verite est le depot applicatif, pas le chart : c'est donc
      # celle du chart qui s'efface. Son Alertmanager, lui, ne fait doublon avec
      # rien et reste actif.
      defaultDatasourceEnabled: false
    dashboards:
      enabled: true
      # Tableaux de bord UrbanLink, etiquetes `grafana_dashboard: "1"`.
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: {{ k8s_observability_namespace }}

# --- Prometheus -------------------------------------------------------------
prometheus:
  prometheusSpec:
    # ⚠️ `secrets:` et NON `secretMounts:`. Ce dernier n'existe dans aucune
    # version du chart ni dans la CRD Prometheus : l'API le supprime
    # silencieusement au moment de l'admission (pruning), le volume n'est
    # jamais monte, et le scrape du backend echoue en 401 sans que rien
    # n'indique pourquoi.
    #
    # Le chemin de montage est impose par l'operateur :
    #   /etc/prometheus/secrets/<nom du Secret>/<cle>
    # d'ou le credentials_file ci-dessous. Le Secret entier est monte, mais
    # seul METRICS_TOKEN est lu.
    secrets:
      - urbanconnect-secrets
    additionalScrapeConfigs:
      # ⚠️ LES QUATRE CIBLES APPLICATIVES NE SONT PLUS ICI.
      #
      # `urbanconnect-backend`, `otel-collector`, `tempo` et `loki` etaient
      # quatre `static_configs` visant des ClusterIP. Or le Deployment `backend`
      # a DEUX replicas : un ClusterIP donne UNE cible, que kube-proxy repartit
      # entre les pods. Prometheus lisait donc une seule serie alimentee
      # alternativement par deux compteurs desynchronises, et chaque descente
      # etait comptee comme une remise a zero -- tous les `rate()` sur
      # `urbanconnect_*` etaient gonfles, sans qu'aucune erreur ne le signale.
      #
      # Elles sont devenues des ServiceMonitor, qui decouvrent les ENDPOINTS et
      # donnent une cible par pod :
      #   kube/urbanlink/observability/servicemonitors.yaml
      # Ce fichier-la est pose par Argo, pas par Helm : c'est du kustomize.
      #
      # `secrets: [urbanconnect-secrets]` ci-dessus n'est PLUS utilise par le
      # scrape (le ServiceMonitor reference la cle directement, et l'operateur
      # la resout). Il est conserve : le retirer changerait le volume monte dans
      # le pod Prometheus pour un gain nul.

      # --- Messagerie ---------------------------------------------------------
      # La VM 140 porte Mailcow et vit HORS du cluster : ni ServiceMonitor ni
      # decouverte possible, c'est une cible statique assumee.
      #
      # Elle expose, en plus des metriques systeme habituelles, deux familles
      # produites par une sonde locale (role Ansible `mailcow`) :
      #   mail_dnsbl_listed        inscription de l'IP d'emission en liste noire
      #   mail_queue_size          file d'attente de Postfix
      # C'est `mail_dnsbl_listed` qui repond a l'exigence de depart : savoir
      # qu'on est blackliste AVANT que ca ne se voie dans le courrier des
      # destinataires.
      - job_name: messagerie
        static_configs:
          - targets: ['10.0.0.140:9100']
            labels:
              instance: mail
              role: messagerie

      # --- Maillage Istio -----------------------------------------------------
      # Repris TEL QUEL du job `kubernetes-pods` de l'addon Prometheus d'Istio
      # (samples/addons/prometheus.yaml), qui a ete supprime : c'etait le SEUL
      # job produisant la telemetrie du mesh, et sans lui on perdait d'un coup
      # le graphe de Kiali et le tableau de bord « Istio Mesh ».
      #
      # La decouverte se fait par ANNOTATION, pas par ServiceMonitor -- c'est
      # ainsi qu'Istio expose ses composants. Cinq pods portent aujourd'hui
      # `prometheus.io/scrape: "true"` (releve le 2026-09-02) :
      #
      #   istio-ingress/istio-ingressgateway  :15020 /stats/prometheus
      #                                       -> istio_requests_total, latences
      #   istio-system/istiod                 :15014 /metrics
      #   istio-system/ztunnel                :15020 /metrics
      #   istio-system/istio-cni-node         :15014 /metrics
      #   istio-system/kiali                  :9090  /metrics
      #
      # `honor_labels: true` est indispensable : Envoy pose lui-meme `job` et
      # `instance`, et les ecraser casserait les requetes des tableaux de bord
      # Istio, qui s'appuient dessus.
      - job_name: kubernetes-pods
        honor_labels: true
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - action: keep
            regex: true
            source_labels:
              - __meta_kubernetes_pod_annotation_prometheus_io_scrape
          - action: replace
            regex: (https?)
            source_labels:
              - __meta_kubernetes_pod_annotation_prometheus_io_scheme
            target_label: __scheme__
          - action: replace
            regex: (.+)
            source_labels:
              - __meta_kubernetes_pod_annotation_prometheus_io_path
            target_label: __metrics_path__
          - action: replace
            regex: (\d+);(([A-Fa-f0-9]{1,4}::?){1,7}[A-Fa-f0-9]{1,4})
            replacement: '[$2]:$1'
            source_labels:
              - __meta_kubernetes_pod_annotation_prometheus_io_port
              - __meta_kubernetes_pod_ip
            target_label: __address__
          - action: replace
            regex: (\d+);((([0-9]+?)(\.|$)){4})
            replacement: $2:$1
            source_labels:
              - __meta_kubernetes_pod_annotation_prometheus_io_port
              - __meta_kubernetes_pod_ip
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - action: replace
            source_labels:
              - __meta_kubernetes_namespace
            target_label: namespace
          - action: replace
            source_labels:
              - __meta_kubernetes_pod_name
            target_label: pod
          - action: drop
            regex: Pending|Succeeded|Failed|Completed
            source_labels:
              - __meta_kubernetes_pod_phase
          - action: replace
            source_labels:
              - __meta_kubernetes_pod_node_name
            target_label: node
    # Regles dans kube/urbanlink/observability/prometheus-alerts.yaml, etiquete
    # `release: kube-prometheus-stack` pour etre selectionne ici -- comme les
    # regles par defaut du chart, qui portent le meme label.
    ruleSelector:
      matchLabels:
        release: kube-prometheus-stack
    # Cluster mono-noeud.
    replicas: 1
    retention: 15d
    # Sans `storageSpec`, l'operateur donne a Prometheus un emptyDir : les
    # quinze jours de retention annonces ci-dessus disparaitraient au premier
    # redemarrage du pod. `local-path` est la seule StorageClass du cluster et
    # elle est par defaut, il n'y a donc rien a nommer ici.
    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 20Gi

# ---------------------------------------------------------------------------
#  Plan de controle : ce qui n'est PAS scrapable sur ce noeud
# ---------------------------------------------------------------------------
# Releve sur urbanlink le 2026-09-01, dans /etc/kubernetes/manifests :
#
#   etcd                    --listen-metrics-urls=http://127.0.0.1:2381
#   kube-controller-manager --bind-address=127.0.0.1
#   kube-scheduler          --bind-address=127.0.0.1
#   kube-proxy              metricsBindAddress: ""  -> 127.0.0.1:10249
#
# Les quatre n'ecoutent que sur la boucle locale ; Prometheus les joindrait par
# l'IP du noeud et recevrait un refus de connexion. Laisser leurs
# ServiceMonitors actifs donnerait quatre cibles DOWN en permanence, donc
# `TargetDown` et `KubeControllerManagerDown` en continu -- un bruit de fond
# qui rend le reste des alertes illisible.
#
# Les desactiver ne perd aucune mesure qui existe aujourd'hui. Les recuperer
# demanderait de rebinder le plan de controle sur 0.0.0.0, ce qui est un
# chantier distinct et pas sans consequence sur l'exposition du noeud.
kubeEtcd:
  enabled: false
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false

# --- Alertmanager -----------------------------------------------------------
alertmanager:
  config:
    route:
      receiver: {{ 'ops' if grafana_smtp_smarthost | length > 0 else '"null"' }}
      # ⚠️ `group_by` A TROIS DIMENSIONS, pas seulement `alertname`.
      #
      # Avec `["alertname"]` seul, les deux replicas du backend en difficulte
      # arrivaient dans UNE ligne : impossible de voir depuis la page si un
      # seul pod derivait ou les deux. Ajouter `namespace` et `severity` donne
      # un groupe par incident reel, sans fragmenter -- `pod` ici ouvrirait au
      # contraire une ligne par pod pour une panne de noeud.
      group_by: ["alertname", "namespace", "severity"]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        # `Watchdog` est une alerte du chart qui tire EN PERMANENCE, par
        # conception : elle prouve que la chaine d'alerte fonctionne. La
        # laisser suivre la route par defaut enverrait un courriel toutes les
        # quatre heures, indefiniment.
        - receiver: "null"
          matchers:
            - alertname = "Watchdog"
        - receiver: "null"
          matchers:
            - alertname = "InfoInhibitor"
        # Les `critical` se regroupent plus court et se repetent plus souvent :
        # attendre cinq minutes qu'un groupe se complete a du sens pour un
        # avertissement, pas pour un backend a l'arret.
        - receiver: {{ 'ops' if grafana_smtp_smarthost | length > 0 else '"null"' }}
          matchers:
            - severity = "critical"
          group_wait: 10s
          group_interval: 1m
          repeat_interval: 1h
          continue: false

    # -----------------------------------------------------------------------
    #  INHIBITIONS -- ce qui empeche une panne de produire trente alertes
    # -----------------------------------------------------------------------
    #  Il n'y en avait AUCUNE. Sur un cluster mono-noeud, c'est ce qui fait la
    #  difference entre une page lisible et une page qu'on renonce a lire.
    #
    #  ⚠️ Une inhibition n'eteint pas la regle : l'alerte reste ACTIVE dans
    #  Prometheus et visible dans l'onglet correspondant. Elle cesse seulement
    #  d'etre notifiee et de figurer en tete d'Alertmanager. Ce n'est pas un
    #  silence -- rien n'est masque, tout est ordonne.
    inhibit_rules:
      # 1. LE NOEUD EMPORTE TOUT. Cluster mono-noeud : sa chute rend
      #    simultanement vrais PodNotReady, DeploymentReplicasMismatch,
      #    BackendDown, PrometheusTargetDown, les deux *PipelineSilent... qui
      #    disent tous la meme chose. `equal: []` parce qu'il n'y a aucune
      #    etiquette commune a exiger : la panne est globale par nature.
      #
      #    ⚠️ `alertname != "NodeNotReady"` cote cible, et ce n'est pas
      #    redondant. Avec un `=~ ".+"` nu, l'alerte figure des DEUX cotes de
      #    la regle. Alertmanager documente qu'une alerte ne s'inhibe pas
      #    elle-meme dans ce cas, mais recommande explicitement de ne pas
      #    laisser source et cible se recouvrir : on ne fait pas dependre la
      #    visibilite de la panne la plus grave d'un cas particulier du
      #    moteur.
      - source_matchers:
          - alertname = "NodeNotReady"
        target_matchers:
          - alertname != "NodeNotReady"
        equal: []

      # 2. UN BACKEND ARRETE N'A PAS UN PROBLEME DE LATENCE. Sans cette regle,
      #    l'arret des deux replicas produisait trois alertes -- BackendDown,
      #    BackendHighErrorRate, BackendHighLatency -- dont deux sont des
      #    consequences mecaniques de la premiere.
      - source_matchers:
          - alertname = "BackendDown"
        target_matchers:
          - alertname =~ "Backend(HighErrorRate|HighLatency|EventLoopBlocked|HeapNearLimit|FileDescriptorsHigh)"
        equal: []

      - source_matchers:
          - alertname = "BackendNoReplicas"
        target_matchers:
          - alertname =~ "DeploymentReplicasMismatch|PodNotReady"
        equal: ["namespace"]

      # 3. UNE CIBLE MUETTE EXPLIQUE LES SILENCES QUI SUIVENT. Si Tempo, Loki
      #    ou le collecteur ne repond plus au scrape, l'absence de spans en est
      #    la consequence, pas un second incident.
      #
      #    ⚠️ Le filtre sur `job` est indispensable. Sans lui, N'IMPORTE QUELLE
      #    cible muette -- le backend, kube-state-metrics -- ferait taire les
      #    alertes de telemetrie, alors qu'elle n'a rien a voir avec elles. Une
      #    inhibition trop large est exactement aussi dangereuse qu'une alerte
      #    absente : elle supprime un signal vrai.
      - source_matchers:
          - alertname = "PrometheusTargetDown"
          - job =~ "otel-collector|tempo|loki"
        target_matchers:
          - alertname =~ "TelemetryPipelineSilent|LogPipelineSilent|OTelQueueNearFull"
        equal: []

      # 4. LE CRITIQUE EFFACE L'AVERTISSEMENT DU MEME OBJET. Regle generale,
      #    volontairement en dernier. `equal` porte sur les etiquettes
      #    d'identite -- deux alertes sur DES PODS DIFFERENTS ne s'inhibent
      #    jamais l'une l'autre, ce qui serait le vrai danger d'une inhibition
      #    trop large.
      - source_matchers:
          - severity = "critical"
        target_matchers:
          - severity = "warning"
        equal: ["alertname", "namespace", "pod"]

    receivers:
      - name: "null"
{% if grafana_smtp_smarthost | length > 0 %}
      - name: ops
        email_configs:
          - to: ops@{{ k8s_observability_domain }}
            from: alertmanager@{{ k8s_observability_domain }}
            smarthost: {{ grafana_smtp_smarthost }}
            auth_username: {{ grafana_smtp_username }}
            auth_password: "{{ grafana_smtp_password }}"
            send_resolved: true
{% else %}
      # GRAFANA_SMTP_* sont vides dans secrets.env : aucun recepteur email
      # n'est declare et tout est route vers `null`.
      #
      # Ce n'est pas de la prudence, c'est une obligation. Alertmanager REFUSE
      # une configuration dont un `email_configs` n'a pas de smarthost
      # (« no global SMTP smarthost set ») : ecrire un recepteur `ops` avec un
      # champ vide ne mettrait pas les courriels de cote, cela empecherait
      # Alertmanager de demarrer.
      #
      # Les alertes restent visibles dans Grafana et dans l'UI d'Alertmanager.
      # Pour les recevoir par courriel : renseigner GRAFANA_SMTP_SMARTHOST,
      # _USERNAME et _PASSWORD dans secrets.env, puis rejouer ce role.
{% endif %}
  alertmanagerSpec:
    # ⚠️ `alertmanagerSpec.replicas` et non `alertmanager.replicas` : ce dernier
    # n'existe pas dans le chart, Helm l'aurait ignore en silence.
    replicas: 1

# Les PodDisruptionBudget de Prometheus, d'Alertmanager et de l'operateur sont
# deja a `enabled: false` dans les valeurs par defaut du chart 88.x -- rien a
# desactiver ici. (Il n'existe pas non plus de `global.defaultPodDisruptionBudget`
# dans ce chart : l'y ecrire n'aurait eu aucun effet.)
