# {{ ansible_managed }}
# Valeurs Helm du kube-prometheus-stack -- role kubernetes (observability.yml).
#
# Deploie Prometheus (avec son operator), Grafana et Alertmanager dans le
# namespace `urbanconnect`, a cote de l'observabilite applicative posee par
# Argo (OTel/Tempo/Loki). Le Prometheus du MESH (addon Istio, istio-system)
# reste celui que consomme Kiali, expose sous prometheus.urbanlink.fr : c'est
# un SECOND Prometheus, volontairement separe, qui alimente les tableaux de
# bord Istio. Les deux cohabitent -- cf.
# config/prod/observability/grafana-datasources.yaml.
#
# Secrets : aucun n'est ecrit ici. Le mot de passe admin de Grafana arrive par
# {{ grafana_admin_password }} (issu de secrets.env, injecte par
# observability.yml). Le jeton de scrape du backend vit dans le Secret
# `urbanconnect-secrets` (cle METRICS_TOKEN), monte dans le pod Prometheus par
# `prometheusSpec.secretMounts` -- see additionalScrapeConfigs ci-dessous.

# --- Grafana ----------------------------------------------------------------
grafana:
  adminUser: alesio
  adminPassword: "{{ grafana_admin_password }}"
  sidecar:
    datasources:
      enabled: true
      # Decouverte des ConfigMaps generee par kustomize : `grafana-datasources`
      # est etiquete `grafana_datasource: "1"` (voir kustomization.yaml).
      label: grafana_datasource
      labelValue: "1"
      searchNamespace: urbanconnect
    dashboards:
      enabled: true
      # Tableaux de bord UrbanLink, etiquete `grafana_dashboard: "1"`.
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: urbanconnect

# --- Prometheus -------------------------------------------------------------
prometheus:
  prometheusSpec:
    # Le backend protege /metrics par Bearer. Le jeton est monte depuis le
    # Secret `urbanconnect-secrets` (cle METRICS_TOKEN), jamais duplique.
    secretMounts:
      - name: app-metrics-auth
        secretName: urbanconnect-secrets
        mountPath: /etc/prometheus/secrets
        readOnly: true
    additionalScrapeConfigs:
      # Backend NestJS : metriques metier (urbanconnect_*).
      - job_name: urbanconnect-backend
        metrics_path: /metrics
        authorization:
          credentials_file: /etc/prometheus/secrets/METRICS_TOKEN
          type: Bearer
        static_configs:
          - targets:
              - backend.urbanconnect.svc.cluster.local:4000
            labels:
              job: urbanconnect-backend
      # Collecteur OTel : telemetrie interne.
      - job_name: otel-collector
        metrics_path: /metrics
        static_configs:
          - targets:
              - otel-collector.urbanconnect.svc.cluster.local:8888
            labels:
              job: otel-collector
      # Tempo : metriques internes du backend de traces.
      - job_name: tempo
        metrics_path: /metrics
        static_configs:
          - targets:
              - tempo.urbanconnect.svc.cluster.local:3200
            labels:
              job: tempo
      # Loki : metriques internes du backend de journaux.
      - job_name: loki
        metrics_path: /metrics
        static_configs:
          - targets:
              - loki.urbanconnect.svc.cluster.local:3100
            labels:
              job: loki
    # Regles dans kube/urbanlink/observability/prometheus-alerts.yaml, etiquete
    # `release: kube-prometheus-stack` pour etre selectionne ici.
    ruleSelector:
      matchLabels:
        release: kube-prometheus-stack
    # Cluster mono-noeud : un replica. Les PDB par defaut du chart
    # laisseraient des pods non planifiables (meme constat que pour istiod).
    replicas: 1
    podDisruptionBudget:
      enabled: false

# --- Alertmanager -----------------------------------------------------------
alertmanager:
  config:
    route:
      receiver: ops
      group_by: ["alertname"]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
    receivers:
      - name: ops
        email_configs:
          - to: ops@urbanlink.fr
            from: alertmanager@urbanlink.fr
            smarthost: {{ grafana_smtp_smarthost }}
            auth_username: {{ grafana_smtp_username }}
            auth_password: "{{ grafana_smtp_password }}"
            send_resolved: true
  # Cluster mono-noeud.
  replicas: 1

# --- Cluster mono-noeud -----------------------------------------------------
global:
  defaultPodDisruptionBudget:
    enabled: false