# Genere par Ansible (role mail_tunnel). Toute edition manuelle sera ecrasee.
#
# Cote VM de messagerie -- a la maison, derriere le NAT du lab.

# ⚠️ TOUTES les directives PostUp/PostDown ci-dessous sont ECRITES POUR ETRE
# REJOUEES. wg-quick tourne en `set -e` : une seule erreur -- une route qui
# existe deja, une regle absente qu'on tente de supprimer -- et le tunnel ne
# remonte pas. C'est arrive le 2026-09-05 : des routes `throw` survivantes
# d'une instance precedente ont fait echouer `ip route add` avec « File
# exists », et la messagerie s'est retrouvee sans tunnel.
#
# D'ou `ip route replace` plutot que `add`, un `del` prealable avant chaque
# `ip rule add` (qui, lui, creerait un doublon silencieux), et `|| true` sur
# tous les PostDown.
#
# ⚠️ Le `|| true` du `del` prealable n'est PAS decoratif : sous `set -e`, un
# point-virgule ne protege de rien. Une suppression de regle inexistante --
# le cas normal au premier demarrage -- suffisait a faire echouer le tunnel.

[Interface]
Address = {{ mail_tunnel_mail_ip }}/30
PrivateKey = {{ wg_private_key }}

# `Table = off` est OBLIGATOIRE ici, et c'est la consequence directe de
# l'AllowedIPs = 0.0.0.0/0 du pair, plus bas. Sans lui, wg-quick installerait
# une route par defaut vers le tunnel dans la table principale : toute la VM
# sortirait par le VPS, elle deviendrait injoignable depuis le lab et
# inadministrable des que le tunnel tomberait.
#
# Les seules routes voulues sont posees a la main : la route connectee de
# {{ mail_tunnel_subnet }} vient de l'adresse ci-dessus, et la table 100 est
# construite dans les PostUp.
Table = off

# --- Routage du SEUL reseau Docker de Mailcow par le tunnel ------------------
# Le critere est le RESEAU, pas le port, et ce n'est pas un raccourci :
#
#   * Postfix tourne dans un CONTENEUR : son trafic traverse FORWARD, jamais
#     OUTPUT. Un marquage `-t mangle -A OUTPUT --dport 25` n'attraperait rien.
#
#   * Pour une connexion ENTRANTE DNATee, la traduction inverse du paquet de
#     reponse n'a lieu qu'en POSTROUTING, donc APRES la decision de routage :
#     a cet instant la reponse porte encore l'adresse du conteneur. Une regle
#     `ip rule from 10.88.0.2` ne matcherait jamais et les reponses partiraient
#     par la passerelle du lab -- c'est-a-dire dans le vide.
#
# Router tout le reseau Docker regle les deux sens d'un coup.
#
# La VM elle-meme GARDE sa route par defaut vers le lab : elle reste joignable,
# a jour et administrable meme tunnel coupe.
PostUp = ip rule del from {{ mail_tunnel_docker_net }} lookup 100 pref 100 2>/dev/null || true; ip rule add from {{ mail_tunnel_docker_net }} lookup 100 pref 100
PostDown = ip rule del from {{ mail_tunnel_docker_net }} lookup 100 pref 100 2>/dev/null || true

# Seconde regle, pour le trafic de l'HOTE et non des conteneurs : tout paquet
# dont la source est l'adresse du tunnel doit repartir par le tunnel.
#
# Sans elle, une reponse sourcee en {{ mail_tunnel_mail_ip }} -- celle d'un
# service publie sur l'hote, ou d'un simple test -- repartirait par la
# passerelle du lab, serait NATee par le Proxmox et n'atteindrait jamais son
# destinataire. Symptome mesure le 2026-09-05 : les SYN arrivaient bien sur
# wg0, et l'emetteur ne recevait rien, pas meme un RST.
PostUp = ip rule del from {{ mail_tunnel_mail_ip }} lookup 100 pref 101 2>/dev/null || true; ip rule add from {{ mail_tunnel_mail_ip }} lookup 100 pref 101
PostDown = ip rule del from {{ mail_tunnel_mail_ip }} lookup 100 pref 101 2>/dev/null || true
PostUp = ip route replace default via {{ mail_tunnel_vps_ip }} dev wg0 table 100
PostDown = ip route del default via {{ mail_tunnel_vps_ip }} dev wg0 table 100 2>/dev/null || true

# --- Les destinations PRIVEES retombent sur la table principale --------------
# Une route `throw` fait echouer la recherche dans la table 100 et rend la main
# aux regles suivantes, donc a la table principale.
#
# Sans ces trois lignes, la regle ci-dessus capture aussi le trafic LOCAL :
#   * l'adresse du pont Docker de l'hote (172.22.1.1) appartient au reseau
#     source, donc les reponses de l'hote vers un conteneur partaient dans le
#     tunnel -- l'interface Mailcow ne repondait plus, meme en 127.0.0.1 ;
#   * les reponses aux requetes du LAN (l'openresty du noeud, en 192.168.100.50,
#     qui proxifie la console de la messagerie) partaient de meme par le VPS,
#     qui les masquait derriere son IP publique : la console devenait
#     injoignable.
# Mesure le 2026-09-05.
PostUp = ip route replace throw 10.0.0.0/8 table 100
PostDown = ip route del throw 10.0.0.0/8 table 100 2>/dev/null || true
PostUp = ip route replace throw 172.16.0.0/12 table 100
PostDown = ip route del throw 172.16.0.0/12 table 100 2>/dev/null || true
PostUp = ip route replace throw 192.168.0.0/16 table 100
PostDown = ip route del throw 192.168.0.0/16 table 100 2>/dev/null || true

# Le pair n'accepte que {{ mail_tunnel_mail_ip }} dans ses AllowedIPs : sans ce
# SNAT, les paquets partiraient en 172.22.1.x et WireGuard les refuserait.
# Route de retour vers les appareils nomades. Elle est INDISPENSABLE et elle
# va dans la table PRINCIPALE : le reseau des appareils ({{ mail_tunnel_peer_subnet }})
# tombe dans le 10.0.0.0/8 que la table 100 rejette par une route `throw`. Sans
# cette ligne, un telephone pourrait ouvrir une connexion IMAP et n'en recevoir
# aucune reponse.
PostUp = ip route replace {{ mail_tunnel_peer_subnet }} via {{ mail_tunnel_vps_ip }} dev wg0
PostDown = ip route del {{ mail_tunnel_peer_subnet }} via {{ mail_tunnel_vps_ip }} dev wg0 2>/dev/null || true

PostUp = iptables -t nat -C POSTROUTING -s {{ mail_tunnel_docker_net }} -o wg0 -j SNAT --to-source {{ mail_tunnel_mail_ip }} 2>/dev/null || iptables -t nat -A POSTROUTING -s {{ mail_tunnel_docker_net }} -o wg0 -j SNAT --to-source {{ mail_tunnel_mail_ip }}
PostDown = iptables -t nat -D POSTROUTING -s {{ mail_tunnel_docker_net }} -o wg0 -j SNAT --to-source {{ mail_tunnel_mail_ip }} 2>/dev/null || true

[Peer]
# VPS Hostinger
PublicKey = {{ hostvars[mail_tunnel_vps_host].wg_public_key }}
Endpoint = {{ mail_tunnel_public_ip }}:{{ mail_tunnel_port }}

# 0.0.0.0/0 ne veut PAS dire « route tout par le tunnel » -- c'est `Table = off`
# qui l'empeche. AllowedIPs est d'abord un FILTRE : WireGuard jette tout paquet
# entrant dont l'adresse SOURCE n'y figure pas (cryptokey routing).
#
# Or le courrier entrant arrive DNATe, avec l'IP source de l'expediteur -- une
# adresse Internet quelconque, par construction. Avec `AllowedIPs =
# 10.88.0.1/32`, le tunnel jetait ces paquets EN SILENCE : la regle DNAT du VPS
# comptait bien le paquet, et la VM ne voyait jamais la connexion. Mesure le
# 2026-09-05, et c'est exactement le mode de panne que preserver l'IP source
# rend possible.
AllowedIPs = 0.0.0.0/0
# La VM est derriere le NAT du lab : c'est elle qui doit entretenir la session,
# sinon la table de traduction expire et le VPS ne peut plus la joindre --
# donc plus aucun courrier entrant.
PersistentKeepalive = 25
