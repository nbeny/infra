#!/bin/bash
# Genere par Ansible (role mailcow). Toute edition manuelle sera ecrasee.
#
# Produit deux familles de metriques au format textfile de node_exporter :
#   * l'inscription de l'IP d'emission dans les listes noires ;
#   * l'etat de la file d'attente de Postfix.
#
# ⚠️ LE RESOLVEUR N'EST PAS UN DETAIL. Spamhaus REFUSE les requetes venant des
# resolveurs publics et repond 127.255.255.254 avec « Error: open resolver ».
# Or 127.255.255.* tombe dans la meme plage que les reponses d'inscription :
# un script naif conclurait que l'IP est listee, et l'alerte hurlerait en
# permanence pour rien. On interroge donc l'unbound recursif de Mailcow, qui
# sort par le tunnel avec l'IP du VPS.
set -uo pipefail

IP={{ mailcow_sending_ip }}
RESOLVER={{ mailcow_dnsbl_resolver }}
REV=$(echo "$IP" | awk -F. '{print $4"."$3"."$2"."$1}')
OUT={{ mailcow_textfile_dir }}/mail.prom
TMP="${OUT}.$$"

ZONES="{{ mailcow_dnsbl_zones | join(' ') }}"

healthy=1

{
  echo "# HELP mail_dnsbl_listed 1 si l'IP d'emission est listee sur cette zone."
  echo "# TYPE mail_dnsbl_listed gauge"
  for z in $ZONES; do
    ans=$(dig +short +time=3 +tries=1 "@${RESOLVER}" "${REV}.${z}" 2>/dev/null | head -1)
    case "$ans" in
      127.255.255.*)
        # Reponse d'ERREUR du service, pas une inscription. Ne pas la compter
        # comme une inscription, mais ne pas la passer sous silence non plus.
        v=0; healthy=0 ;;
      127.*)
        v=1 ;;
      *)
        v=0 ;;
    esac
    echo "mail_dnsbl_listed{zone=\"${z}\",ip=\"${IP}\"} ${v}"
  done

  # Une sonde qui repond « propre » alors qu'elle n'a pas pu interroger les
  # listes est pire qu'une sonde absente : elle rassure a tort.
  echo "# HELP mail_dnsbl_probe_healthy 1 si toutes les zones ont repondu normalement."
  echo "# TYPE mail_dnsbl_probe_healthy gauge"
  echo "mail_dnsbl_probe_healthy ${healthy}"

  echo "# HELP mail_dnsbl_last_check_timestamp_seconds Date du dernier passage de la sonde."
  echo "# TYPE mail_dnsbl_last_check_timestamp_seconds gauge"
  echo "mail_dnsbl_last_check_timestamp_seconds $(date +%s)"

  # --- IP d'emission REELLE -------------------------------------------------
  # ⚠️ CETTE METRIQUE EXISTE PARCE QUE TOUT LE RESTE DE CE FICHIER A MENTI
  # PENDANT SEPT JOURS.
  #
  # Le 2026-09-13, un redemarrage de systemd-networkd a efface les `ip rule`
  # du tunnel. Les conteneurs sont retombes sur la route par defaut du lab et
  # ont emis depuis l'IP de la maison, en liste noire Spamhaus. Outlook a
  # rejete sec, Gmail a classe en indesirables.
  #
  # Rien n'a bronche : le tunnel est reste UP, la file d'attente est restee
  # VIDE (Gmail acceptait), et les metriques `mail_dnsbl_*` ci-dessus sont
  # restees vertes -- parce qu'elles interrogent {{ mailcow_sending_ip }},
  # l'IP qu'on ESPERE utiliser, jamais celle qu'on utilise vraiment.
  #
  # Surveiller une intention ne surveille rien. On mesure donc l'EFFET.
  #
  # Deux mesures, parce qu'elles n'attrapent pas les memes pannes.
  #
  # --- a) La DECISION DE ROUTAGE du noyau -----------------------------------
  # `ip route get ... iif` demande au noyau ce qu'il ferait d'un paquet arrivant
  # du pont Docker : c'est exactement le chemin du trafic de Postfix, qui est
  # FORWARDE et non emis localement. Sans `iif`, le noyau repond « Network is
  # unreachable » et la mesure ne veut rien dire.
  #
  # Exact, instantane, sans acces reseau, SANS CACHE -- et surtout TESTABLE :
  # retirer la regle fait passer la reponse de « via 10.88.0.1 dev wg0 » a
  # « via 10.0.0.1 dev eth0 » dans la seconde. C'est ce qui permet de verifier
  # que l'alarme sonne vraiment, au lieu de l'esperer.
  route=$(ip route get {{ mailcow_egress_probe_dst }} \
            from {{ mailcow_egress_probe_src }} \
            iif {{ mailcow_egress_bridge }} 2>/dev/null | head -1)

  echo "# HELP mail_egress_route_ok 1 si le noyau route bien le reseau Docker par le tunnel."
  echo "# TYPE mail_egress_route_ok gauge"
  case "$route" in
    *"dev wg0"*) echo "mail_egress_route_ok 1" ;;
    "")          echo "mail_egress_route_ok 0" ;;
    *)           echo "mail_egress_route_ok 0" ;;
  esac

  # --- b) L'IP reellement vue par le monde ----------------------------------
  # Complementaire, et non redondante : la mesure (a) ne verrait pas un SNAT
  # casse sur le VPS, ni un changement d'IP publique du VPS.
  #
  # ⚠️ Elle passe par l'unbound de Mailcow, qui MET EN CACHE. Le TTL de
  # `o-o.myaddr.l.google.com` est de 60 s et la sonde tourne toutes les
  # {{ mailcow_probe_interval }} : en regime normal le cache a toujours expire.
  # Mais deux executions rapprochees rendent la MEME valeur, meme si le routage
  # a change entre-temps. Constate le 2026-09-20 en testant cette sonde.
  #
  # C'est pour cela que l'alerte s'appuie d'abord sur (a) : une mesure qu'on ne
  # peut pas tester est une mesure en qui on ne peut pas avoir confiance.
  observee=$(dig +short +time=3 +tries=1 "@${RESOLVER}" TXT o-o.myaddr.l.google.com 2>/dev/null \
             | tr -d '"' | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)

  echo "# HELP mail_egress_probe_healthy 1 si la sonde a pu determiner l'IP d'emission reelle."
  echo "# TYPE mail_egress_probe_healthy gauge"
  echo "# HELP mail_egress_ip_correct 1 si le courrier part bien par l'IP attendue."
  echo "# TYPE mail_egress_ip_correct gauge"
  echo "# HELP mail_egress_ip_info Adresse observee et adresse attendue, en etiquettes."
  echo "# TYPE mail_egress_ip_info gauge"

  if [ -z "${observee:-}" ]; then
    # Une sonde qui n'a pas pu mesurer ne doit SURTOUT pas repondre « 0 » :
    # elle declencherait une alerte critique sur un alea DNS. Elle se declare
    # aveugle, et c'est une autre alerte, en avertissement, qui s'en charge.
    echo "mail_egress_probe_healthy 0"
  else
    echo "mail_egress_probe_healthy 1"
    if [ "$observee" = "{{ mailcow_sending_ip }}" ]; then
      echo "mail_egress_ip_correct 1"
    else
      echo "mail_egress_ip_correct 0"
    fi
    echo "mail_egress_ip_info{observee=\"${observee}\",attendue=\"{{ mailcow_sending_ip }}\"} 1"
  fi

  # --- File d'attente -------------------------------------------------------
  # Une file qui gonfle est le premier symptome d'un tunnel coupe ou d'un
  # grand fournisseur qui refuse les remises.
  q=$(docker exec {{ mailcow_postfix_container }} postqueue -p 2>/dev/null \
      | tail -1 | grep -oE '^-- [0-9]+ Kbytes in [0-9]+ Request' | grep -oE '[0-9]+ Request' | grep -oE '^[0-9]+')
  [ -z "${q:-}" ] && q=0
  d=$(docker exec {{ mailcow_postfix_container }} find /var/spool/postfix/deferred -type f 2>/dev/null | wc -l)
  [ -z "${d:-}" ] && d=0

  echo "# HELP mail_queue_size Messages en attente dans la file Postfix."
  echo "# TYPE mail_queue_size gauge"
  echo "mail_queue_size ${q}"
  echo "# HELP mail_queue_deferred Messages differes (echec temporaire de remise)."
  echo "# TYPE mail_queue_deferred gauge"
  echo "mail_queue_deferred ${d}"
} > "$TMP"

# Ecriture atomique : node_exporter lit ce repertoire en continu et un fichier
# a moitie ecrit lui ferait rendre des metriques tronquees.
mv "$TMP" "$OUT"
chmod 644 "$OUT"
