# Copie ce fichier en `terraform.tfvars` (ignore par git) puis renseigne-le.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Il ne contient QUE les secrets. La liste des VMs est versionnee dans
# lab.auto.tfvars, que Terraform charge tout seul. Ne pas y redeclarer `vms` :
# les *.auto.tfvars sont lus APRES terraform.tfvars, la copie serait ignoree.

# ---------------------------------------------------------------------------
#  Acces API
# ---------------------------------------------------------------------------
# Valeur affichee une seule fois, a la creation du token :
#   ansible-playbook playbooks/00-proxmox-host.yml -t token -e pve_create_api_token=true
pve_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# pve_endpoint = "https://192.168.100.50:8006/"
# pve_insecure = true

# ---------------------------------------------------------------------------
#  macOS
# ---------------------------------------------------------------------------
# Cle de 64 caracteres renvoyee par le SMC des Macs Apple, sans laquelle macOS
# ne demarre pas. A extraire d'un vrai Mac -- voir docs/macos-ci.md.
# Necessaire seulement si `macos_vms` (lab.auto.tfvars) n'est pas vide.
# macos_osk = "................................................................"
