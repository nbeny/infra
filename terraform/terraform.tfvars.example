# Copie ce fichier en `terraform.tfvars` (ignore par git) puis adapte-le.
#
#   cp terraform.tfvars.example terraform.tfvars

# ---------------------------------------------------------------------------
#  Acces API
# ---------------------------------------------------------------------------
# Valeur affichee une seule fois, a la creation du token :
#   ansible-playbook playbooks/00-proxmox-host.yml -t token -e pve_create_api_token=true
pve_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# pve_endpoint = "https://192.168.100.50:8006/"
# pve_insecure = true

# ---------------------------------------------------------------------------
#  Machines
# ---------------------------------------------------------------------------
# Convention du lab : le dernier octet de l'IP est egal au VMID.
# Deja pris : 100 UrbanConnect, 101 Alesio, 102 Other, 103 Kali.
# Reserve   : 9000-9999 (templates et VMs de build Packer).

vms = {

  # --- VM de validation de la chaine complete -------------------------------
  "test-k8s" = {
    profile     = "debian-k8s"
    vm_id       = 190
    ip          = "10.0.0.190"
    cores       = 4
    sockets     = 1
    memory      = 8192
    disk_size   = 64
    on_boot     = false
    # `on_boot` NE SUFFIT PAS a garder une VM eteinte. Il ne regit que le
    # demarrage du noeud ; l'etat courant est regi par `started`, dont le
    # defaut est `true`. Sans la ligne ci-dessous, un `terraform apply`
    # RALLUME la VM -- constate le 2026-09-05 sur test-k8s et kali-test.
    started     = false
    tags        = ["test"]
    description = "VM jetable de validation. Supprimable sans consequence."
  }

  # --- Poste offensif Kali --------------------------------------------------
  "kali-test" = {
    profile     = "kali"
    vm_id       = 120
    ip          = "10.0.0.120"
    cores       = 4
    memory      = 8192
    disk_size   = 100        # >= 64 : le template fait deja 64 Go
    on_boot     = false
    started     = false   # voir la note sur `started` plus haut
    tags        = ["test", "offsec"]
    description = "VM Kali de validation. Supprimable sans consequence."
  }

  # --- Stack applicatif UrbanLink -------------------------------------------
  # Dimensionne pour les manifests de kube/urbanlink : ~54 Gio de requests
  # memoire, ~69 Gio de LIMITS (dont 32 pour le seul nominatim) et ~548 Gio de
  # volumes une fois tous les composants demarres.
  #
  # BUDGET MEMOIRE DU NOEUD -- 110 Go utilisables au total.
  # ATTENTION : le decompte precedent OUBLIAIT les deux VMs qui tournent
  # reellement a cote, et comptait deux VMs de test qui sont eteintes. Le vrai:
  #
  #   urbanlink   96 Go   balloon 0  -- ne rend RIEN
  #   ci-runner   12 Go   balloon 4  -- VM MANUELLE, absente de cet etat
  #   mail         8 Go   balloon 4
  #   ARC ZFS      4 Go              -- plafonne dans /etc/modprobe.d/zfs.conf
  #   PVE        ~1,5 Go
  #   -------------------
  #   plafond   121,5 Go  -> 11 Go AU-DESSUS du physique
  #   plancher  109,5 Go  -> tient, mais a 500 Mo pres
  #
  # CE DIMENSIONNEMENT NE TIENT QUE PAR LE BALLONNEMENT DE ci-runner ET mail.
  # Si l'un des deux travaille pendant que l'autre est charge -- un build CI et
  # une remise de courrier au meme instant -- le noeud depasse le physique et
  # l'OOM killer choisit LUI-MEME quelle VM tuer. Il ne choisira pas la moins
  # importante.
  #
  # Avant d'allumer test-k8s (8 Go), kali-test (8 Go), UrbanConnect (VM 100,
  # 96 Go) ou une VM macOS (8 Go, SANS ballonnement) : redescendre urbanlink
  # d'autant. Il n'y a plus de marge a prendre ailleurs.
  "urbanlink" = {
    profile     = "debian-k8s"
    vm_id       = 111
    # Demarre en PREMIER, et laisse 90 s a Kubernetes pour se poser avant que la
    # VM suivante ne vienne disputer la memoire : c'est la plus grosse, et la
    # seule sans ballooning.
    startup_order    = 1
    startup_up_delay = 90
    ip          = "10.0.0.111"
    cores       = 12
    sockets     = 2     # 24 vCPU sur les 32 threads du noeud
    memory      = 98304 # 96 Go
    disk_size   = 700
    # etcd SUR SSD. Le disque systeme vit sur pool2 = UN SEUL Hitachi 3 To a
    # 7200 tr/min, et etcd fsync a chaque ecriture. Mesure sur 12 jours :
    # 30 859 fsync du WAL au-dela de 8 ms, dont 192 au-dela de 1 s et 7 au-dela
    # de 8 s. Passe 5 s, le controller-manager et le scheduler perdent leur
    # bail et sortent en `leaderelection lost` -- 125 et 129 redemarrages. Le
    # symptome ressemble a une panne memoire ; c'en est une de latence disque.
    #
    # `local-lvm` est le thinpool du SSD Intel DC S3610 du noeud : 107 Go
    # libres, 0 % utilise. La base etcd fait 403 Mo -- 32 Go couvrent sa
    # croissance et ses instantanes pour des annees.
    extra_disk = {
      size      = 32
      datastore = "local-lvm"
    }
    on_boot     = true
    tags        = ["app", "urbanlink"]
    description = "Cluster Kubernetes hebergeant le stack UrbanLink."
  }

  # --- Reconstruction du host principal -------------------------------------
  # Reprend le dimensionnement exact de UrbanConnect (VM 100) mais sous un
  # nouveau VMID : la VM 100 existante n'est JAMAIS touchee par Terraform.
  # Deploie celle-ci, migre les donnees, puis retire l'ancienne quand tu es
  # sur de toi.
  #
  # "urbanconnect" = {
  #   profile     = "debian-k8s"
  #   vm_id       = 110
  #   ip          = "10.0.0.110"
  #   cores       = 12
  #   sockets     = 2
  #   memory      = 96000
  #   disk_size   = 1000
  #   datastore   = "pool1"    # la 100 est sur pool1 ; pool2 a plus de place
  #   on_boot     = true
  #   tags        = ["prod"]
  #   description = "Host principal reconstruit depuis le template golden."
  # }
}

# ---------------------------------------------------------------------------
#  Machines macOS
# ---------------------------------------------------------------------------
# CHAINE DIFFERENTE des VMs Linux -- ni Packer, ni cloud-init :
#   1. ansible-playbook playbooks/11-macos-template.yml -e pve_macos_osk='...'
#   2. installation GRAPHIQUE manuelle, une seule fois (docs/macos-ci.md)
#   3. qm template 9200
#   4. terraform apply
#
# PLAFOND MATERIEL -- le noeud est un Xeon E5-2680 (Sandy Bridge, 2012) sans
# AVX2. macOS Ventura et au-dela ne demarrent pas : le cache dyld d'Apple n'est
# compile que pour AVX2. Monterey (12) est le maximum, donc Xcode 14.2 et le
# SDK iOS 16.2. Suffisant pour compiler et tester, insuffisant pour soumettre
# a l'App Store.
#
# BUDGET MEMOIRE -- macOS n'a pas de ballooning : la VM prend ses 8 Go et ne
# les rend jamais. Les ajouter au total deja surengage decrit plus haut :
#   urbanlink 96 + macos-ci 8 = 104 Go sur 110 Go physiques.
# Il ne reste alors plus rien pour test-k8s ni kali-test.

# Cle de 64 caracteres renvoyee par le SMC des Macs Apple, sans laquelle macOS
# ne demarre pas. A extraire d'un vrai Mac -- voir docs/macos-ci.md.
# macos_osk = "................................................................"

macos_vms = {

  # --- Runner de compilation Apple ------------------------------------------
  # "macos-ci" = {
  #   vm_id     = 140
  #   ip        = "10.0.0.140"   # INFORMATIF : saisi a la main dans macOS
  #   cores     = 4              # puissance de 2 obligatoire
  #   memory    = 8192
  #   disk_size = 200            # Xcode ~40 Go + simulateurs 8-12 Go chacun
  #   datastore = "pool1"        # pool1 est vide et a 3,5 To
  #   on_boot   = false
  #   tags      = ["ci", "macos"]
  #   description = "Runner de compilation Xcode. Plafonne a Xcode 14.2."
  # }

  # --- Messagerie urbanlink.fr (profil debian-base) --------------------------
  # Clone du SOCLE 9000, pas d'un template golden : ni Docker ni Kubernetes
  # preinstalles. Docker arrive ensuite par playbooks/40-mail-vm.yml.
  #
  # `agent` : le socle 9000 est l'image cloud brute de Debian, sans
  # qemu-guest-agent. Il faut donc creer la VM avec `agent = false` -- sinon
  # l'apply echoue apres cinq minutes d'attente -- puis, une fois
  # 40-mail-vm.yml joue :
  #
  #     qm set 140 --agent enabled=1 && qm stop 140 && qm start 140
  #
  # L'ARRET/DEMARRAGE est indispensable : Proxmox n'attache le peripherique
  # virtio-serial de l'agent qu'au demarrage, et un `reboot` depuis l'invite ne
  # suffit pas -- le service qemu-guest-agent echoue alors sur une dependance
  # manquante. Repasser ensuite `agent = true` ici, sans quoi le prochain apply
  # redesactiverait l'agent, donc le fsfreeze de vzdump.
  #
  # "mail" = {
  #   profile         = "debian-base"
  #   vm_id           = 140
  #   ip              = "10.0.0.140"
  #   cores           = 2
  #   memory          = 8192
  #   memory_floating = 4096      # ballooning : rend la RAM inutilisee a l'hote
  #   disk_size       = 150
  #   agent           = true
  #   on_boot         = true
  #   tags            = ["mail"]
  #   description     = "Mailcow -- boites urbanlink.fr. Emission via le VPS."
  # }

}
