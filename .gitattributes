# ============================================================================
#  Fins de ligne
# ----------------------------------------------------------------------------
#  Le depot est edite sous Windows et execute sous Linux. Un fichier livre en
#  CRLF a un interpreteur POSIX echoue de maniere deroutante : le \r final est
#  vu comme faisant partie du dernier mot.
#
#  Cas reellement rencontre : create-databases.sh en CRLF donnait
#      set: pipefail: invalid option name
#  parce que bash lisait `pipefail\r`. Le script mourait a la ligne 5, les
#  bases kratos, directus et temporal n'etaient jamais creees, et Kratos
#  tournait en boucle sans que le lien soit visible.
# ============================================================================

# Par defaut, git normalise a la detection.
*           text=auto

# Scripts et configurations interpretes sous Linux : LF impose.
*.sh        text eol=lf
*.bash      text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.jsonnet   text eol=lf
*.j2        text eol=lf

# Scripts RouterOS : appliques via l'API, meme exigence.
*.rsc       text eol=lf

# Fichiers sans extension executes sous Linux.
Dockerfile* text eol=lf

# Scripts Windows : CRLF assume.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binaires : jamais touches.
*.png       binary
*.jpg       binary
*.pdf       binary
*.gz        binary
*.qcow2     binary
