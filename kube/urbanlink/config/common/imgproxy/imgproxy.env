# ============================================================================
#  imgproxy -- redimensionnement et conversion des images publiques (MinIO)
# ----------------------------------------------------------------------------
#  Identique en dev (docker-compose) et en prod (ConfigMap `imgproxy-config`,
#  `envs:` du configMapGenerator d'infra) : MinIO s'appelle `minio:9000` et le
#  seau `urbanconnect-images` dans les deux.
#
#  Chemin d'une image : navigateur -> /api/img/<largeur>/<cle> (route Next,
#  `front/src/app/api/img/`) -> imgproxy, URL SIGNEE -> MinIO.
#  imgproxy n'est publie nulle part : seul le serveur Next lui parle, et lui
#  seul detient IMGPROXY_KEY / IMGPROXY_SALT (secrets, PAS dans ce fichier --
#  `.env` racine en dev, Secret `urbanconnect-secrets` en prod).
#
#  ⚠️ La source est le seau en HTTP ANONYME, et c'est la securite du montage :
#  les prefixes prives (messages/, disputes/, exports/, CV, stories/,
#  document-import/) sont refuses aux anonymes par la politique du seau
#  (`storage.service.ts`). Des identifiants S3 (`IMGPROXY_USE_S3`) liraient
#  TOUT le seau, et la route servirait une piece jointe privee a qui connait sa
#  cle. Ne pas « simplifier » en S3.
# ============================================================================

IMGPROXY_BASE_URL=http://minio:9000/urbanconnect-images/
IMGPROXY_ALLOWED_SOURCES=http://minio:9000/urbanconnect-images/

# Cles d'objet = uuid (jamais reecrites) : le resultat est cachable un an.
IMGPROXY_TTL=31536000

# WebP pour tous : le format est dans l'URL (`.webp`), donc la reponse ne
# depend pas de l'en-tete Accept et un cache partage (Cloudflare) ne peut pas
# servir de l'AVIF a un navigateur qui ne le lit pas.
IMGPROXY_FORMAT_QUALITY=webp=78

# Retire EXIF/IPTC -- dont la position GPS d'une photo prise au telephone,
# qui trahirait l'adresse que `fakeAddress` cache.
IMGPROXY_STRIP_METADATA=true

# Delais. Une page de resultats demande ~40 vignettes d'un coup : avec le
# defaut de 5 s, un MinIO lent sous la rafale (mesure en dev : 5 echecs sur 43,
# alors que chaque objet seul repond en 0,2 s) faisait tomber des vignettes.
# Le total reste sous les 15 s d'attente de la route /api/img.
IMGPROXY_DOWNLOAD_TIMEOUT=10
IMGPROXY_TIMEOUT=12

# Garde-fous contre une source piegee (bombe de decompression).
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_MAX_SRC_FILE_SIZE=26214400
