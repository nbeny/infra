# ============================================================================
#  PgBouncer -- reglages de pool, PRODUCTION (Kubernetes)
# ----------------------------------------------------------------------------
#  Meme role que config/dev/pgbouncer/pgbouncer.env, dimensionne pour le
#  cluster. Les differences avec le dev, et leur raison :
#
#    DEFAULT_POOL_SIZE  20 -> 25   le Deployment tourne a 2 replicas : le
#                                  nombre de connexions REELLES vers Postgres
#                                  est `replicas x DEFAULT_POOL_SIZE` par paire
#                                  (base, utilisateur). 2 x 25 = 50, plus la
#                                  reserve, sous les 100 de max_connections.
#    MAX_CLIENT_CONN   200 -> 500  cote client on peut etre genereux : une
#                                  connexion en attente coute quelques Ko, elle
#                                  ne consomme pas de backend Postgres.
#    LOG_CONNECTIONS     0 -> 0    inchange, et delibere : le volume rendrait
#                                  Loki inexploitable pour zero information.
#
#  ⚠️ Toucher DEFAULT_POOL_SIZE sans regarder `max_connections` de Postgres est
#  la facon classique de transformer un pooler en goulot : le pooler accepte,
#  Postgres refuse, et l'erreur remonte comme une panne applicative.
#
#  AUCUN identifiant ici : DB_NAME / DB_USER / DB_PASSWORD sont injectes depuis
#  le Secret `urbanconnect-secrets` par pgbouncer/deployment.yaml.
# ============================================================================

DB_HOST=postgres
DB_PORT=5432

LISTEN_PORT=6432
POOL_MODE=transaction

MAX_CLIENT_CONN=500
DEFAULT_POOL_SIZE=25
MIN_POOL_SIZE=5
RESERVE_POOL_SIZE=5
RESERVE_POOL_TIMEOUT=5
SERVER_IDLE_TIMEOUT=600
CLIENT_IDLE_TIMEOUT=600

LOG_CONNECTIONS=0
LOG_DISCONNECTIONS=0
LOG_POOLER_ERRORS=1

IGNORE_STARTUP_PARAMETERS=extra_float_digits

AUTH_TYPE=scram-sha-256
