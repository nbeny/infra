    {
      "id": 6,
      "type": "stat",
      "title": "Nœud prêt",
      "description": "Cluster **mono-nœud** : sa chute emporte tout. C'est aussi pourquoi `NodeNotReady` inhibe toutes les autres alertes dans Alertmanager — sans quoi une seule panne en déclencherait trente.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
          "instant": true,
          "legendFormat": "nœuds prêts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NON",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OUI",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Mémoire du nœud",
      "description": "`MemAvailable` est la seule valeur qui compte pour décider s'il reste de la place : le cache et les tampons sont récupérables à la demande, les compter comme « occupés » est trompeur.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(node_memory_MemTotal_bytes)",
          "legendFormat": "totale"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(node_memory_MemAvailable_bytes)",
          "legendFormat": "disponible"
