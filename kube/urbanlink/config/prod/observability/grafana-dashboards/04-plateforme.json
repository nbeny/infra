    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disque / — libre, et projection à 24 h",
      "description": "La courbe rouge est `predict_linear` sur six heures d'historique, projetée à 24 h. **Quand elle passe sous zéro, le disque sera plein demain** — c'est le déclencheur de l'alerte `NodeDiskFillingUp`, et c'est le seul signal qui laisse le temps d'agir. Un seuil fixe à 85 % ne dit rien de la vitesse.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(node_filesystem_avail_bytes{mountpoint=\"/\"})",
          "legendFormat": "libre maintenant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h], 24 * 3600))",
          "legendFormat": "libre projeté à 24 h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "libre projeté à 24 h"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
