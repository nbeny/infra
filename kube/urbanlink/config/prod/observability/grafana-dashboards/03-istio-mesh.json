{
  "title": "Istio Mesh",
  "uid": "urbanlink-istio-mesh",
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "tags": ["urbanlink", "istio"],
  "panels": [
    {
      "id": 1,
      "title": "Latence inter-services (p95, ms)",
      "type": "timeseries",
      "datasource": { "uid": "prometheus-mesh" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace!=\"istio-system\"}[5m])) by (le, source_workload, destination_workload))",
          "legendFormat": "{{source_workload}} -> {{destination_workload}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Taux erreurs par workload (5xx)",
      "type": "timeseries",
      "datasource": { "uid": "prometheus-mesh" },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{response_code=~\"5..\", destination_workload_namespace!=\"istio-system\"}[5m])) by (destination_workload)",
          "legendFormat": "{{destination_workload}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Trafic entrant par destination",
      "type": "timeseries",
      "datasource": { "uid": "prometheus-mesh" },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total[5m])) by (destination_service)",
          "legendFormat": "{{destination_service}}"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" }
}