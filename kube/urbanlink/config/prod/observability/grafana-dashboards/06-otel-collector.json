{
  "title": "OTel Collector",
  "uid": "urbanlink-otel",
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "tags": ["urbanlink", "otel"],
  "panels": [
    {
      "id": 1,
      "title": "Spans recus (receiver)",
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_otlp_spans_received_total[5m]))",
          "legendFormat": "spans/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Spans exportes (exporter)",
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_otlp_sent_spans_total[5m]))",
          "legendFormat": "spans/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Echecs d'envoi (batch exporter)",
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[5m]))",
          "legendFormat": "send failures/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memoire residente",
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "otelcol_process_resident_memory_bytes",
          "legendFormat": "rss"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" }
}