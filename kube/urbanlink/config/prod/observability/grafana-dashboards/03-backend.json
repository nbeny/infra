    {
      "id": 5,
      "type": "stat",
      "title": "Replicas prêts",
      "description": "Nombre de pods `backend` prêts. La métrique est `kube_deployment_status_replicas_ready` — **et non** `kube_deployment_status_ready_replicas`, qui n'existe pas : ce nom-là, écrit dans l'alerte `DeploymentReplicasMismatch`, la rendait muette depuis sa création.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_ready{namespace=\"urbanconnect\", deployment=\"backend\"}",
          "instant": true,
          "legendFormat": "prêts"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_spec_replicas{namespace=\"urbanconnect\", deployment=\"backend\"}",
          "instant": true,
          "legendFormat": "désirés"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
