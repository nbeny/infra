{
  "title": "Journaux - Loki",
  "uid": "urbanlink-logs",
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "tags": ["urbanlink", "logs"],
  "panels": [
    {
      "id": 1,
      "title": "Flux de journaux (lignes/s) par service",
      "type": "timeseries",
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({deployment.environment.name=\"production\"}[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Erreurs recentes",
      "type": "logs",
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{deployment.environment.name=\"production\"} |= \"error\"",
          "queryType": "range"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" }
}