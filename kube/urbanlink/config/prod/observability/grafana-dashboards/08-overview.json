{
  "title": "Vue d'ensemble UrbanLink",
  "uid": "urbanlink-overview",
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "tags": ["urbanlink", "overview"],
  "panels": [
    {
      "id": 1,
      "title": "Sante globale (nombre d'alertes actives)",
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"})",
          "legendFormat": "alertes"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requetes API /s",
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(urbanconnect_http_requests_total[5m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taux d'erreur API (5xx)",
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(urbanconnect_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(urbanconnect_http_requests_total[5m]))",
          "legendFormat": "5xx ratio",
          "unit": "percentunit"
        }
      ]
    },
    {
      "id": 4,
      "title": "Payouts vendeurs bloques",
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "urbanconnect_seller_payouts_pending{status=\"BLOCKED\"}",
          "legendFormat": "blocked"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" }
}