# ============================================================================
#  Nominatim -- import OSM, PRODUCTION (Kubernetes)
# ----------------------------------------------------------------------------
#  Meme role que config/dev/nominatim/nominatim.env, sur la France entiere.
#
#  ⚠️ CE QUE CET IMPORT COUTE, avant de l'appliquer :
#    - telechargement    ~4,5 Go
#    - duree             quelques heures selon le disque
#    - base resultante   ~15-20 Go
#    - memoire           le pic d'import reste le poste dimensionnant
#
#  Le pod reste NotReady tout du long. Ce n'est pas une panne : la sonde de
#  readiness interroge /search, qui ne repond qu'une fois la base indexee.
#
#  Sur un noeud unique, isoler ce pod (taint/toleration) evite qu'il n'etouffe
#  le reste du stack pendant l'import. Le nodeSelector est laisse a l'operateur
#  du cluster : le cluster urbanlink n'a qu'un noeud, il n'y a rien a isoler.
#
#  ⚠️ POURQUOI LA FRANCE ET NON L'EUROPE (~32 Go), qui etait la valeur d'avant :
#  releve sur le cluster urbanlink le 2026-08-30, apres 17 heures et
#  21 redemarrages, `data.osm.pbf` pesait 23,2 Go -- soit 72 % du chemin, sans
#  jamais atteindre l'import.
#
#  Le telechargement AVANCE donc, mais par a-coups : le pool d'adresses de
#  Geofabrik a rendu trois IP differentes pour le meme nom en trois
#  resolutions, et certaines acceptent la connexion TLS puis ne delivrent RIEN
#  -- curl reste a zero octet jusqu'a expiration, le conteneur sort, kubelet le
#  relance, et la tentative suivante retombe au hasard sur une bonne ou une
#  mauvaise adresse. `curl -C -` reprend bien sur le PVC, d'ou les 23 Go
#  accumules ; c'est la duree totale qui devient deraisonnable.
#
#  Et le telechargement n'est que la premiere moitie : l'import lui-meme
#  demande des heures a plus d'une journee pour l'Europe, avec un pic memoire
#  de 16 Gi et une base de 60 a 80 Go. Sur ce lab, c'est le poste dominant.
#  Mesure a l'appui, l'extrait France se sert lui a pleine vitesse : 3 essais
#  sur 3, 2 Mo chacun en moins de 1,1 s.
#
#  ⚠️ Basculer JETTE ces 23 Go : `data.osm.pbf` doit etre SUPPRIME avant, sinon
#  `curl -C -` tente de reprendre un fichier de 4,5 Go a l'octet 23 000 000 000.
#
#  ⚠️ C'est une reduction de COUVERTURE FONCTIONNELLE, pas un reglage : une
#  adresse belge ou allemande ne sera plus geocodee par ce Nominatim. L'impact
#  est borne parce que le geocodeur PRIMAIRE du produit est la BAN gouv.fr
#  (`geocoding.service.ts`), qui couvre la France ; Nominatim est le repli, et
#  le repli couvre desormais exactement le meme territoire que le primaire.
#  Repasser a l'Europe se fait en remettant les deux URL ci-dessous -- en
#  sachant que le probleme de telechargement, lui, n'aura pas disparu.
# ============================================================================

# --- Source des donnees ----------------------------------------------------
PBF_URL=https://download.geofabrik.de/europe/france-latest.osm.pbf
REPLICATION_URL=https://download.geofabrik.de/europe/france-updates/

# `continuous` : Nominatim applique les diffs Geofabrik en continu apres
# l'import. Sans ca la base fige a la date de l'extrait et vieillit en
# silence -- une adresse creee depuis n'existe simplement pas.
UPDATE_MODE=continuous

# --- Contenu de l'import ---------------------------------------------------
IMPORT_WIKIPEDIA=false
IMPORT_US_POSTCODES=false
IMPORT_GB_POSTCODES=false
IMPORT_TIGER_ADDRESSES=false
IMPORT_STYLE=address

# --- Base ------------------------------------------------------------------
# POSTGRES_PASSWORD vient du Secret `urbanconnect-secrets`
# (cle NOMINATIM_DB_PASSWORD), injecte par nominatim/statefulset.yaml.
POSTGRES_HOST=postgres-nominatim
POSTGRES_USER=nominatim
POSTGRES_DB=nominatim

# A aligner sur `limits.cpu` du StatefulSet (4000m). Au-dela, l'import se
# bat contre lui-meme pour du temps CPU que le cgroup ne donnera pas.
THREADS=4
