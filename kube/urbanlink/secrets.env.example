# ============================================================================
#  Secrets du stack UrbanLink -- MODELE
# ----------------------------------------------------------------------------
#  Copier en `secrets.env` et renseigner. Ce fichier-ci est versionne, le
#  votre ne l'est pas (voir .gitignore).
#
#  La source de verite est GitHub Secrets, pas ce fichier :
#
#      scripts/secrets/bootstrap.sh       genere les valeurs aleatoires
#      scripts/secrets/github-sync.sh     les pousse dans GitHub Secrets
#
#  Le Secret Kubernetes est cree par playbooks/31-urbanlink-deploy.yml avec
#  `kubectl create secret generic --from-env-file`. Il n'y a plus de manifest
#  secrets.yaml : un Secret en clair dans un depot est une bombe a retardement,
#  et l'ancien fichier ne contenait que des CHANGE_ME -- c'est d'ailleurs
#  pourquoi la moitie du stack ne demarrait pas.
#
#  TROIS CATEGORIES, marquees ci-dessous :
#    [auto]     genere par bootstrap.sh -- ne pas remplir a la main
#    [identite] pas un secret : nom d'utilisateur, de base, adresse
#    [externe]  fourni par un tiers -- A RENSEIGNER, personne ne peut le deviner
# ============================================================================

# --- PostgreSQL applicatif --------------------------------------------------
POSTGRES_USER=urbanconnect                                  # [identite]
POSTGRES_DB=urbanconnect                                    # [identite]
POSTGRES_PASSWORD=                                          # [auto]
# Compose depuis POSTGRES_* par bootstrap.sh -- passe par pgbouncer.
DATABASE_URL=                                               # [auto]

# --- PostgreSQL Kratos ------------------------------------------------------
KRATOS_DB_USER=kratos                                       # [identite]
KRATOS_DB_NAME=kratos                                       # [identite]
KRATOS_DB_PASSWORD=                                         # [auto]
KRATOS_DSN=                                                 # [auto]
# Kratos EXIGE au moins 32 caracteres. L'ancien placeholder en faisait 31,
# et Kratos refusait de demarrer : "length must be >= 32, but got 31".
KRATOS_SECRET=                                              # [auto]
KRATOS_WEBHOOK_SECRET=                                      # [auto]

# --- PostgreSQL Directus ----------------------------------------------------
DIRECTUS_DB_USER=directus                                   # [identite]
DIRECTUS_DB_NAME=directus                                   # [identite]
DIRECTUS_DB_PASSWORD=                                       # [auto]
DIRECTUS_ADMIN_EMAIL=admin@urbanlink.fr                     # [identite]
DIRECTUS_ADMIN_PASSWORD=                                    # [auto]
DIRECTUS_SECRET=                                            # [auto]

# --- PostgreSQL Nominatim et Temporal ---------------------------------------
NOMINATIM_DB_PASSWORD=                                      # [auto]
TEMPORAL_DB_USER=temporal                                   # [identite]
TEMPORAL_DB_PASSWORD=                                       # [auto]

# --- Outils d'administration ------------------------------------------------
PGADMIN_EMAIL=admin@urbanlink.fr                            # [identite]
PGADMIN_PASSWORD=                                           # [auto]

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=                                             # [auto]
REDIS_URL=                                                  # [auto]

# --- Elasticsearch et Kibana ------------------------------------------------
ELASTICSEARCH_PASSWORD=                                     # [auto]
KIBANA_SYSTEM_PASSWORD=                                     # [auto]

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=urbanlink-admin                             # [identite]
MINIO_BUCKET_NAME=urbanlink-media                           # [identite]
MINIO_ROOT_PASSWORD=                                        # [auto]

# --- Application ------------------------------------------------------------
JWT_SECRET=                                                 # [auto]
JWT_EXPIRATION=7d                                           # [identite]
METRICS_TOKEN=                                              # [auto]

# --- WebRTC (coturn) --------------------------------------------------------
TURN_SECRET=                                                # [auto]
# Les hotes STUN/TURN. `turn.urbanlink.fr` n'a PAS d'enregistrement DNS a ce
# jour : coturn tourne en hostNetwork sur les noeuds publics. A creer avant
# de compter dessus pour des appels reels.
TURN_URLS=stun:turn.urbanlink.fr:3478,turn:turn.urbanlink.fr:3478?transport=udp,turn:turn.urbanlink.fr:3478?transport=tcp   # [identite]

# ============================================================================
#  [externe] -- personne ne peut les generer. Sans eux, la fonction associee
#  ne marche pas, mais le stack demarre : ils sont tous `optional: true` cote
#  manifests, sauf mention contraire.
# ============================================================================

# --- Google OAuth (connexion Kratos) ----------------------------------------
# Console Google Cloud > Credentials > OAuth 2.0 Client ID.
# URI de redirection a declarer :
#   https://auth.urbanlink.fr/self-service/methods/oidc/callback/google
GOOGLE_CLIENT_ID=                                           # [externe]
GOOGLE_CLIENT_SECRET=                                       # [externe]

# --- Envoi de courrier (Infomaniak) -----------------------------------------
SMTP_CONNECTION_URI=                                        # [externe]
SMTP_FROM_ADDRESS=noreply@urbanlink.fr                      # [identite]
SMTP_FROM_NAME=UrbanLink                                    # [identite]

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=                                          # [externe]
STRIPE_PUBLISHABLE_KEY=                                     # [externe]
STRIPE_WEBHOOK_SECRET=                                      # [externe]
STRIPE_CONNECT_WEBHOOK_SECRET=                              # [externe]
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=                              # [externe]

# --- Divers tiers -----------------------------------------------------------
KLIPY_API_KEY=                                              # [externe]
SMSAPI_TOKEN=                                               # [externe]
SMSAPI_SENDER=UrbanLink                                     # [identite]
SENDCLOUD_PUBLIC_KEY=                                       # [externe]
SENDCLOUD_SECRET_KEY=                                       # [externe]
MAXMIND_ACCOUNT_ID=                                         # [externe]
MAXMIND_LICENSE_KEY=                                        # [externe]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                             # [externe]
