# ============================================================================
#  Secrets du stack UrbanLink -- MODELE
# ----------------------------------------------------------------------------
#  Copier en `secrets.env` et renseigner. Ce fichier-ci est versionne, le
#  votre ne l'est pas (voir .gitignore).
#
#  La source de verite est GitHub Secrets, pas ce fichier :
#
#      scripts/secrets/bootstrap.sh       genere les valeurs aleatoires
#      scripts/secrets/github-sync.sh     les pousse dans GitHub Secrets
#
#  Le Secret Kubernetes est cree par playbooks/31-urbanlink-deploy.yml avec
#  `kubectl create secret generic --from-env-file`. Il n'y a plus de manifest
#  secrets.yaml : un Secret en clair dans un depot est une bombe a retardement,
#  et l'ancien fichier ne contenait que des CHANGE_ME -- c'est d'ailleurs
#  pourquoi la moitie du stack ne demarrait pas.
#
#  TROIS CATEGORIES, marquees ci-dessous :
#    [auto]     genere par bootstrap.sh -- ne pas remplir a la main
#    [identite] pas un secret : nom d'utilisateur, de base, adresse
#    [externe]  fourni par un tiers -- A RENSEIGNER, personne ne peut le deviner
# ============================================================================

# --- PostgreSQL applicatif --------------------------------------------------
POSTGRES_USER=urbanconnect                                  # [identite]
POSTGRES_DB=urbanconnect                                    # [identite]
POSTGRES_PASSWORD=                                          # [auto]
# Compose depuis POSTGRES_* par bootstrap.sh -- passe par pgbouncer.
DATABASE_URL=                                               # [auto]

# --- PostgreSQL Kratos ------------------------------------------------------
KRATOS_DB_USER=kratos                                       # [identite]
KRATOS_DB_NAME=kratos                                       # [identite]
KRATOS_DB_PASSWORD=                                         # [auto]
KRATOS_DSN=                                                 # [auto]
# Deux contraintes DIFFERENTES, et Kratos s'arrete si l'une n'est pas tenue :
#   KRATOS_SECRET        -> secrets.cookie, minimum 32 caracteres
#   KRATOS_CIPHER_SECRET -> secrets.cipher, EXACTEMENT 32
# L'ancien placeholder en faisait 31 : "length must be >= 32, but got 31".
KRATOS_SECRET=                                              # [auto]
KRATOS_CIPHER_SECRET=                                       # [auto]
KRATOS_WEBHOOK_SECRET=                                      # [auto]

# --- PostgreSQL Directus ----------------------------------------------------
DIRECTUS_DB_USER=directus                                   # [identite]
DIRECTUS_DB_NAME=directus                                   # [identite]
DIRECTUS_DB_PASSWORD=                                       # [auto]
DIRECTUS_ADMIN_EMAIL=admin@urbanlink.fr                     # [identite]
DIRECTUS_ADMIN_PASSWORD=                                    # [auto]
DIRECTUS_SECRET=                                            # [auto]

# --- PostgreSQL Nominatim et Temporal ---------------------------------------
NOMINATIM_DB_PASSWORD=                                      # [auto]
TEMPORAL_DB_USER=temporal                                   # [identite]
TEMPORAL_DB_PASSWORD=                                       # [auto]

# --- Outils d'administration ------------------------------------------------
PGADMIN_EMAIL=admin@urbanlink.fr                            # [identite]
PGADMIN_PASSWORD=                                           # [auto]

# Compte HUMAIN commun aux consoles internes, pose par
# playbooks/34-console-accounts.yml. Distinct des comptes de service
# ci-dessus, qui restent la propriete du deploiement : celui-ci s'ajoute,
# il ne remplace rien, et se revoque en supprimant un seul utilisateur par
# outil.
#
# ⚠️ pgAdmin et Directus VALIDENT le format e-mail de l'identifiant. Sur ces
# deux consoles seulement, la connexion se fait donc avec CONSOLE_ADMIN_EMAIL
# et non avec CONSOLE_ADMIN_USER. C'est une contrainte des produits, pas un
# choix de deploiement.
CONSOLE_ADMIN_USER=alesio                                   # [identite]
CONSOLE_ADMIN_EMAIL=alesio@urbanlink.fr                     # [identite]
CONSOLE_ADMIN_PASSWORD=                                     # [auto]

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=                                             # [auto]
REDIS_URL=                                                  # [auto]

# --- Observabilite (kube-prometheus-stack) ----------------------------------
# Grafana n'a PAS de mot de passe a lui : son compte admin est le compte humain
# commun ci-dessus (CONSOLE_ADMIN_USER / CONSOLE_ADMIN_PASSWORD), pose par le
# chart Helm dans roles/kubernetes/tasks/observability.yml. Une console de plus
# ne doit pas vouloir dire un mot de passe de plus a retenir.
#
# Relais SMTP d'Alertmanager (emails vers ops@urbanlink.fr). Meme fournisseur
# qu'Infomaniak que SMTP_CONNECTION_URI, mais sous trois champs distincts :
# Alertmanager n'accepte PAS une URI `smtp://`, il exige smarthost `hote:port`
# et identifiants separement. Ex : smtp.infomaniak.ch:587
GRAFANA_SMTP_SMARTHOST=                                     # [identite]
GRAFANA_SMTP_USERNAME=                                      # [identite]
GRAFANA_SMTP_PASSWORD=                                      # [externe]

# --- Elasticsearch et Kibana ------------------------------------------------
ELASTICSEARCH_PASSWORD=                                     # [auto]
KIBANA_SYSTEM_PASSWORD=                                     # [auto]

# --- MinIO ------------------------------------------------------------------
# ⚠️ MINIO_BUCKET_NAME N'EST PAS UN NOM LIBRE. Le front le code EN DUR
#    (`front/src/utils/image.ts` : `const BUCKET_NAME = 'urbanconnect-images'`)
#    parce que c'est un segment d'URL du proxy same-origin, pas un reglage de
#    deploiement ; le back a la meme valeur par defaut
#    (`S3_BUCKET_NAME || 'urbanconnect-images'`). Y mettre autre chose ne
#    renomme donc QUE le cote serveur : le back ecrit dans un bucket et le front
#    lit dans un autre, sans qu'aucune erreur ne le dise.
#    Valait `urbanlink-media` — mesure sur le cluster : bucket cree, 0 objet,
#    et toutes les images introuvables. Le changer ici suppose de changer aussi
#    la constante du front.
MINIO_ROOT_USER=urbanlink-admin                             # [identite]
MINIO_BUCKET_NAME=urbanconnect-images                       # [identite]
MINIO_ROOT_PASSWORD=                                        # [auto]

# --- Application ------------------------------------------------------------
JWT_SECRET=                                                 # [auto]
JWT_EXPIRATION=7d                                           # [identite]
METRICS_TOKEN=                                              # [auto]

# Role Postgres en LECTURE SEULE, pour la source « Postgres (metier) » de
# Grafana. Prometheus compte des EVENEMENTS ; « combien d'inscrits en tout »,
# « la courbe d'inscriptions depuis l'ouverture », « l'entonnoir » sont des
# etats cumules que la base porte deja -- les mettre en serie temporelle
# demanderait une seconde source de verite sur un chiffre existant.
#
# ⚠️ Le role ne peut RIEN ecrire : GRANT SELECT seul, plus
# `ALTER ROLE ... SET default_transaction_read_only = on` par-dessus. Ceinture
# et bretelles, parce qu'un GRANT trop large pose plus tard par distraction ne
# se verrait pas.
GRAFANA_PG_PASSWORD=                                        # [auto]

# --- WebRTC (coturn) --------------------------------------------------------
TURN_SECRET=                                                # [auto]
# Les hotes STUN/TURN. `turn.urbanlink.fr` n'a PAS d'enregistrement DNS a ce
# jour : coturn tourne en hostNetwork sur les noeuds publics. A creer avant
# de compter dessus pour des appels reels.
TURN_URLS=stun:turn.urbanlink.fr:3478,turn:turn.urbanlink.fr:3478?transport=udp,turn:turn.urbanlink.fr:3478?transport=tcp   # [identite]

# ============================================================================
#  [externe] -- personne ne peut les generer. Sans eux, la fonction associee
#  ne marche pas, mais le stack demarre : ils sont tous `optional: true` cote
#  manifests, sauf mention contraire.
# ============================================================================

# --- Google OAuth (connexion Kratos) ----------------------------------------
# Console Google Cloud > Credentials > OAuth 2.0 Client ID.
# URI de redirection a declarer :
#   https://auth.urbanlink.fr/self-service/methods/oidc/callback/google
#
# ⚠️ Ces deux variables ne sont PAS lues par Kratos — il n'accepte une variable
#    d'environnement que si son nom decrit un chemin de sa configuration, et ni
#    l'un ni l'autre n'en decrit un. Elles sont ici parce qu'elles sont la
#    source de verite lisible par un humain : 31-urbanlink-deploy.yml en DERIVE
#    le bloc `providers` complet (JSON brut), qu'il ajoute au Secret sous la
#    cle `KRATOS_OIDC_PROVIDERS` — la seule que Kratos lira, mappee sur
#    SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS.
#    Ne pas ecrire `KRATOS_OIDC_PROVIDERS` ici : il est calcule, pas saisi.
#
#    Laisses vides, le stack demarre normalement ; seule la connexion Google
#    repond « Impossible d'initier la connexion Google ».
GOOGLE_CLIENT_ID=                                           # [externe]
GOOGLE_CLIENT_SECRET=                                       # [externe]

# --- Envoi de courrier (Infomaniak) -----------------------------------------
# Kratos REFUSE de demarrer si cette valeur ne correspond pas a `^smtps?://`.
# bootstrap.sh y met une destination inerte a defaut -- le stack tourne, mais
# aucun courrier ne part tant que la vraie URI Infomaniak n'est pas mise ici.
#
# ⚠️ DEUX consommateurs, une seule URI : Kratos (e-mails d'authentification,
#    sous ses noms `COURIER_SMTP_*`) et le BACKEND (tout le reste : commandes,
#    litiges, messages -- `backTs/src/modules/mail/smtp-config.ts`). Ne pas
#    ajouter un second jeu SMTP_HOST/PORT/USER/PASSWORD : ce serait deux copies
#    du meme identifiant, donc deux endroits a faire tourner et un seul qui
#    sera oublie.
#
# ⚠️ Le port 465 EXIGE le schema `smtps://` (TLS direct). Avec `smtp://`,
#    l'envoi echoue SANS AUCUNE ERREUR visible cote utilisateur.
SMTP_CONNECTION_URI=                                        # [externe]
# ⚠️ DOIT etre la boite reellement authentifiee dans l'URI ci-dessus :
#    Infomaniak refuse un expediteur different. `noreply@urbanlink.fr` NE MARCHE
#    PAS -- cette ligne l'a longtemps propose, et un environnement amorce depuis
#    ce fichier voyait tous ses envois refuses.
SMTP_FROM_ADDRESS=contact@urbanlink.fr                      # [identite]
SMTP_FROM_NAME=UrbanLink                                    # [identite]

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=                                          # [externe]
# ⚠️ OBLIGATOIRE : sans elle, Stripe Connect tourne en MOCK en production
# (comptes `acct_mock_…`, versements impossibles) avec un simple warn.
# Même valeur que STRIPE_SECRET_KEY tant qu'un seul compte Stripe porte Connect.
STRIPE_CONNECT_SECRET_KEY=                                  # [externe]
STRIPE_PUBLISHABLE_KEY=                                     # [externe]
STRIPE_WEBHOOK_SECRET=                                      # [externe]
STRIPE_CONNECT_WEBHOOK_SECRET=                              # [externe]
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=                              # [externe]
# ⚠️ Les trois STRIPE_PRICE_<PLAN>_ID ne sont PAS ici, et ce n'est pas un oubli :
# un price ID n'est pas un secret (il part chez le navigateur dans l'URL du
# Checkout hébergé). Ils sont posés en clair dans backend/deployment.yaml et
# temporal-worker/deployment.yaml, donc réconciliés par Argo CD — les mettre
# dans ce fichier exigerait de rejouer le playbook 31 à chaque changement de
# tarif. Les chercher ici est la première réaction ; d'où cette ligne.

# --- Divers tiers -----------------------------------------------------------
KLIPY_API_KEY=                                              # [externe]
SMSAPI_TOKEN=                                               # [externe]
SMSAPI_SENDER=UrbanLink                                     # [identite]
SENDCLOUD_PUBLIC_KEY=                                       # [externe]
SENDCLOUD_SECRET_KEY=                                       # [externe]
# ⚠️ OBLIGATOIRE : sans lui le backend REFUSE DE DEMARRER en production
#    (SendcloudService.onModuleInit). Il ne figurait pas dans ce gabarit, si
#    bien qu'un secrets.env conforme produisait quand meme un backend incapable
#    de demarrer. Severite voulue : un webhook non signe permet a n'importe qui
#    de declarer un colis « livre », ce qui ouvre le droit de retractation de
#    14 jours sur un envoi qui n'a jamais eu lieu.
#    C'est un secret PARTAGE : sa valeur importe peu tant que Sendcloud n'est
#    pas cable, d'ou [auto]. Au cablage, reprendre celle du tableau de bord.
SENDCLOUD_WEBHOOK_SECRET=                                   # [auto]

# ⚠️ OBLIGATOIRE lui aussi : `STRIPE_CONNECT_WEBHOOK_SECRET is required in
#    production. Refusing to start.` Il figurait bien dans les Deployments,
#    mais restait vide ici — le backend ET le worker refusaient de demarrer.
#    Meme nature que le precedent : secret PARTAGE de verification de
#    signature. Tant qu'aucun webhook Stripe Connect ne pointe vers ce cluster
#    (il n'y a pas de DNS public), une valeur aleatoire convient. Au cablage,
#    reprendre celle que Stripe affiche pour le point d'entree -- une valeur
#    aleatoire ferait alors REJETER tous les evenements, silencieusement du
#    point de vue de l'utilisateur.
STRIPE_CONNECT_WEBHOOK_SECRET=                              # [auto]
MAXMIND_ACCOUNT_ID=                                         # [externe]
MAXMIND_LICENSE_KEY=                                        # [externe]
# « A decouvrir » : cle de diffuseur DATAtourisme (gratuite, compte sur datatourisme.fr)
DATATOURISME_API_KEY=                                       # [externe]
# imgproxy : cle et sel de signature des URL d'image, en hexa (openssl rand -hex 32).
# Lus par le Deployment imgproxy ET par le frontend : les deux doivent etre identiques.
IMGPROXY_KEY=                                               # [auto]
IMGPROXY_SALT=                                              # [auto]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                             # [externe]

# ── Fournisseurs de dropshipping ────────────────────────────────────────────
# Vide = connecteur INACTIF, et c'est un etat de marche legitime : aucun
# catalogue importe, aucune commande envoyee. Les Deployments les declarent en
# `optional: true` pour cette raison — sans ce drapeau, un pod refuserait de
# demarrer tant que la cle n'est pas posee.
#
# ⚠️ **Gratuit veut dire gratuit, pas « essai gratuit »** (verifie le
# 2026-09-15) : ni abonnement, ni carte bancaire, ni periode qui expire. Ces
# fournisseurs gagnent sur la MARCHANDISE, pas sur l'acces a l'API.
#
# ⚠️ **La cle CJ n'est pas le jeton d'appel** : `CJUserNum@api@xxxx…` s'echange
# contre un `accessToken` valable 180 jours, et l'obtention est plafonnee a
# 1 appel/seconde (le serveur rend le meme jeton pendant 24 h). Le connecteur
# doit le mettre en cache — c'est une contrainte du fournisseur, pas une
# optimisation.
#
# ⚠️ Ces valeurs ne passent PAS par les secrets GitHub : la CI n'en consomme que
# deux (`INFRA_DEPLOY_KEY` et la cle Stripe PUBLIQUE). Le chemin est
# `secrets.env` -> amorcage Ansible -> Secret `urbanconnect-secrets`.
CJ_API_KEY=
MATTERHORN_API_KEY=
VIDAXL_API_KEY=
