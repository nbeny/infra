# ============================================================================
#  urbanconnect-temporal-worker:prod
# ----------------------------------------------------------------------------
#  Le depot amont n'a pas de Dockerfile pour ce service : en developpement,
#  docker-compose monte les sources dans un `node:20-slim` et lance
#  `npm install` au demarrage. Ce Dockerfile fige la meme chose en image, ce
#  que Kubernetes exige (pas de bind-mount du code depuis l'hote).
#
#  Pourquoi Debian slim et non Alpine, contrairement au backend :
#  @temporalio/worker embarque core-bridge, un module natif Rust lie a la glibc.
#  Il ne fonctionne pas sur la musl d'Alpine.
#
#  Contexte de build attendu : le repertoire backTs/ du depot UrbanConnct.
#    docker build -f Dockerfile.temporal-worker -t urbanconnect-temporal-worker:prod ./backTs
# ============================================================================

FROM node:20-slim

# openssl est requis par Prisma ; ca-certificates par les appels TLS sortants.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    # Le worker ouvre des connexions par nom d'hote sur plusieurs threads :
    # le pool libuv par defaut (4) devient un goulot d'etranglement.
    UV_THREADPOOL_SIZE=16

# Couche dependances separee : elle ne se reconstruit que si les manifestes
# npm changent, pas a chaque modification du code.
COPY package*.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY . .

# Le client Prisma est genere a partir du schema present dans le contexte.
# Il est regenere au demarrage par la commande du Deployment, mais le faire
# ici evite de payer ce cout a chaque redemarrage de pod.
RUN npx prisma generate

# Surcharge par `command` dans kube/urbanlink/temporal-worker/deployment.yaml.
CMD ["sh", "-c", "npx prisma generate && npm run temporal:worker:nest"]
