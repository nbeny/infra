# Modele des secrets du MikroTik. Rien de tout cela n'est versionne.
#
# Copier en `secrets.env` (variables d'environnement, pour les scripts de ce
# repertoire) et/ou `secrets.rsc` (commandes RouterOS, pour une reconstruction
# complete). Les deux sont listes dans .gitignore.
#
# ---------------------------------------------------------------------------
#  secrets.env  --  lu automatiquement par backup.sh et restore.sh
# ---------------------------------------------------------------------------
# export MIKROTIK_HOST=192.168.100.1
# export MIKROTIK_USER=admin
# export MIKROTIK_PASSWORD='...'
#
# ---------------------------------------------------------------------------
#  secrets.rsc  --  a appliquer apres restore.sh sur un routeur remis a zero
# ---------------------------------------------------------------------------
#      python3 lib/ros_apply.py secrets.rsc
#
# Les fichiers config/*.rsc creent les comptes et le profil wireless sans
# secret : ces lignes-ci les completent.
#
# /user set [find where name="admin"] password="..."
# /user set [find where name="crowdsec"] password="..."
# /interface wireless security-profiles set [find where name="default"] \
#     wpa-pre-shared-key="..." wpa2-pre-shared-key="..."
